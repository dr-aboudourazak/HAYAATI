{"numero":69,"nom_arabe":"الحاقة","basmalah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","versets":[{"numero":1,"texte":"ٱلْحَآقَّةُ","page":566,"tajweed":[[5,7,13]]},{"numero":2,"texte":"مَا ٱلْحَآقَّةُ","page":566,"tajweed":[[4,5,16],[9,11,13]]},{"numero":3,"texte":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","page":566,"tajweed":[[4,6,15],[9,11,10],[14,15,11],[22,23,16],[27,29,13]]},{"numero":4,"texte":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","page":566,"tajweed":[[24,28,9],[29,30,16]]},{"numero":5,"texte":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","page":566,"tajweed":[[4,7,1],[28,30,18],[33,34,16],[34,35,17]]},{"numero":6,"texte":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","page":566,"tajweed":[[4,7,1],[13,17,7],[26,28,18],[35,39,7]]},{"numero":7,"texte":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","page":566,"tajweed":[[24,26,10],[35,39,2],[43,44,11],[66,71,7],[77,78,16],[107,110,1]]},{"numero":8,"texte":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ","page":566,"tajweed":[[18,23,4],[24,27,9]]},{"numero":9,"texte":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ","page":567,"tajweed":[[4,6,14],[24,28,7],[28,30,10],[34,35,11],[38,39,16],[51,52,11],[57,58,16]]},{"numero":10,"texte":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً","page":567,"tajweed":[[8,10,18],[49,54,3]]},{"numero":11,"texte":"إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ","page":567,"tajweed":[[2,5,1],[9,12,1],[20,21,16],[25,27,14],[38,39,11],[48,49,16]]},{"numero":12,"texte":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ","page":567,"tajweed":[[4,6,10],[30,34,2],[42,44,15],[50,54,2],[54,55,11]]},{"numero":13,"texte":"فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ","page":567,"tajweed":[[19,20,16],[20,21,17],[35,39,2],[39,40,11]]},{"numero":14,"texte":"وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً","page":567,