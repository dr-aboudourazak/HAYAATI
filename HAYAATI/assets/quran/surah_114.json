  },
  {
   "numero": 5,
   "texte": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"
  },
  {
   "numero": 6,
   "texte": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"
