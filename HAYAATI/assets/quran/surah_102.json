{
 "numero": 102,
 "nom_arabe": "التكاثر",
 "versets": [
  {
   "numero": 1,
   "texte": "أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"
  },
  {
   "numero": 2,
   "texte": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"
  },
  {
   "numero": 3,
   "texte": "كَلَّا سَوْفَ تَعْلَمُونَ"
  },
  {
   "numero": 4,
   "texte": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"
  },
  {
   "numero": 5,
   "texte": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"
  },
  {
   "numero": 6,
   "texte": "لَتَرَوُنَّ ٱلْجَحِيمَ"
  },
  {
   "numero": 7,
   "texte": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"
  },
  {
   "numero": 8,
   "texte": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"
  }
 ]
}