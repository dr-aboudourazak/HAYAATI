{
 "numero": 104,
 "nom_arabe": "الهمزة",
 "versets": [
  {
   "numero": 1,
   "texte": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"
  },
  {
   "numero": 2,
   "texte": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"
  },
  {
   "numero": 3,
   "texte": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"
  },
  {
   "numero": 4,
   "texte": "كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"
  },
  {
   "numero": 5,
   "texte": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"
  },
  {
   "numero": 6,
   "texte": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"
  },
  {
   "numero": 7,
   "texte": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"
  },
  {
   "numero": 8,
   "texte": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"
  },
  {
   "numero": 9,
   "texte": "فِى عَمَدٍ مُّمَدَّدَةٍۭ"
  }
 ]
}