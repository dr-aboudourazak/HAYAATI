{
 "numero": 88,
 "nom_arabe": "الغاشية",
 "versets": [
  {
   "numero": 1,
   "texte": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ"
  },
  {
   "numero": 2,
   "texte": "وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ"
  },
  {
   "numero": 3,
   "texte": "عَامِلَةٌ نَّاصِبَةٌ"
  },
  {
   "numero": 4,
   "texte": "تَصْلَىٰ نَارًا حَامِيَةً"
  },
  {
   "numero": 5,
   "texte": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"
  },
  {
   "numero": 6,
   "texte": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"
  },
  {
   "numero": 7,
   "texte": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ"
  },
  {
   "numero": 8,
   "texte": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"
  },
  {
   "numero": 9,
   "texte": "لِّسَعْيِهَا رَاضِيَةٌ"
  },
  {
   "numero": 10,
   "texte": "فِى جَنَّةٍ عَالِيَةٍ"
  },
  {
   "numero": 11,
   "texte": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةً"
  },
  {
   "numero": 12,
   "texte": "فِيهَا عَيْنٌ جَارِيَةٌ"
  },
  {
   "numero": 13,
   "texte": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ"
  },
  {
   "numero": 14,
   "texte": "وَأَكْوَابٌ مَّوْضُوعَةٌ"
  },
  {
   "numero": 15,
   "texte": "وَنَمَارِقُ مَصْفُوفَةٌ"
  },
  {
   "numero": 16,
   "texte": "وَزَرَابِىُّ مَبْثُوثَةٌ"
  },
  {
   "numero": 17,
   "texte": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"
  },
  {
   "numero": 18,
   "texte": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"
  },
  {
   "numero": 19,
   "texte": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"
  },
  {
   "numero": 20,
   "texte": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"
  },
  {
   "numero": 21,
   "texte": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ"
  },
  {
   "numero": 22,
   "texte": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"
  },
  {
   "numero": 23,
   "texte": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"
  },
  {
   "numero": 24,
   "texte": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"
  },
  {
   "numero": 25,
   "texte": "إِنَّ إِلَيْنَآ إِيَابَهُمْ"
  },
  {
   "numero": 26,
   "texte": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"
  }
 ]
}