{
 "numero": 96,
 "nom_arabe": "العلق",
 "versets": [
  {
   "numero": 1,
   "texte": "ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"
  },
  {
   "numero": 2,
   "texte": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ"
  },
  {
   "numero": 3,
   "texte": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"
  },
  {
   "numero": 4,
   "texte": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"
  },
  {
   "numero": 5,
   "texte": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ"
  },
  {
   "numero": 6,
   "texte": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ"
  },
  {
   "numero": 7,
   "texte": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"
  },
  {
   "numero": 8,
   "texte": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"
  },
  {
   "numero": 9,
   "texte": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"
  },
  {
   "numero": 10,
   "texte": "عَبْدًا إِذَا صَلَّىٰٓ"
  },
  {
   "numero": 11,
   "texte": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"
  },
  {
   "numero": 12,
   "texte": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"
  },
  {
   "numero": 13,
   "texte": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"
  },
  {
   "numero": 14,
   "texte": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"
  },
  {
   "numero": 15,
   "texte": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"
  },
  {
   "numero": 16,
   "texte": "نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ"
  },
  {
   "numero": 17,
   "texte": "فَلْيَدْعُ نَادِيَهُۥ"
  },
  {
   "numero": 18,
   "texte": "سَنَدْعُ ٱلزَّبَانِيَةَ"
  },
  {
   "numero": 19,
   "texte": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب"
  }
 ]
}