{
 "numero": 70,
 "nom_arabe": "المعارج",
 "versets": [
  {
   "numero": 1,
   "texte": "سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ"
  },
  {
   "numero": 2,
   "texte": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ"
  },
  {
   "numero": 3,
   "texte": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ"
  },
  {
   "numero": 4,
   "texte": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ"
  },
  {
   "numero": 5,
   "texte": "فَٱصْبِرْ صَبْرًا جَمِيلًا"
  },
  {
   "numero": 6,
   "texte": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا"
  },
  {
   "numero": 7,
   "texte": "وَنَرَىٰهُ قَرِيبًا"
  },
  {
   "numero": 8,
   "texte": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ"
  },
  {
   "numero": 9,
   "texte": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ"
  },
  {
   "numero": 10,
   "texte": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا"
  },
  {
   "numero": 11,
   "texte": "يُبَصَّرُونَهُمْ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ"
  },
  {
   "numero": 12,
   "texte": "وَصَٰحِبَتِهِۦ وَأَخِيهِ"
  },
  {
   "numero": 13,
   "texte": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ"
  },
  {
   "numero": 14,
   "texte": "وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ"
  },
  {
   "numero": 15,
   "texte": "كَلَّآ إِنَّهَا لَظَىٰ"
  },
  {
   "numero": 16,
   "texte": "نَزَّاعَةً لِّلشَّوَىٰ"
  },
  {
   "numero": 17,
   "texte": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ"
  },
  {
   "numero": 18,
   "texte": "وَجَمَعَ فَأَوْعَىٰٓ"
  },
  {
   "numero": 19,
   "texte": "إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا"
  },
  {
   "numero": 20,
   "texte": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا"
  },
  {
   "numero": 21,
   "texte": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا"
  },
  {
   "numero": 22,
   "texte": "إِلَّا ٱلْمُصَلِّينَ"
  },
  {
   "numero": 23,
   "texte": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ"
  },
  {
   "numero": 24,
   "texte": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ"
  },
  {
   "numero": 25,
   "texte": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ"
  },
  {
   "numero": 26,
   "texte": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ"
  },
  {
   "numero": 27,
   "texte": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"
  },
  {
   "numero": 28,
   "texte": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ"
  },
  {
   "numero": 29,
   "texte": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ"
  },
  {
   "numero": 30,
   "texte": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"
  },
  {
   "numero": 31,
   "texte": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ"
  },
  {
   "numero": 32,
   "texte": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ"
  },
  {
   "numero": 33,
   "texte": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ"
  },
  {
   "numero": 34,
   "texte": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"
  },
  {
   "numero": 35,
   "texte": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍ مُّكْرَمُونَ"
  },
  {
   "numero": 36,
   "texte": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ"
  },
  {
   "numero": 37,
   "texte": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ"
  },
  {
   "numero": 38,
   "texte": "أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ"
  },
  {
   "numero": 39,
   "texte": "كَلَّآ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ"
  },
  {
   "numero": 40,
   "texte": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ"
  },
  {
   "numero": 41,
   "texte": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ"
  },
  {
   "numero": 42,
   "texte": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ"
  },
  {
   "numero": 43,
   "texte": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ"
  },
  {
   "numero": 44,
   "texte": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ"
  }
 ]
}