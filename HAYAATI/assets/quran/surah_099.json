{
 "numero": 99,
 "nom_arabe": "الزلزلة",
 "versets": [
  {
   "numero": 1,
   "texte": "إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا"
  },
  {
   "numero": 2,
   "texte": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا"
  },
  {
   "numero": 3,
   "texte": "وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا"
  },
  {
   "numero": 4,
   "texte": "يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا"
  },
  {
   "numero": 5,
   "texte": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا"
  },
  {
   "numero": 6,
   "texte": "يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَٰلَهُمْ"
  },
  {
   "numero": 7,
   "texte": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ"
  },
  {
   "numero": 8,
   "texte": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ"
  }
 ]
}