{
 "numero": 87,
 "nom_arabe": "الأعلى",
 "versets": [
  {
   "numero": 1,
   "texte": "سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"
  },
  {
   "numero": 2,
   "texte": "ٱلَّذِى خَلَقَ فَسَوَّىٰ"
  },
  {
   "numero": 3,
   "texte": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ"
  },
  {
   "numero": 4,
   "texte": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"
  },
  {
   "numero": 5,
   "texte": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"
  },
  {
   "numero": 6,
   "texte": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"
  },
  {
   "numero": 7,
   "texte": "إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"
  },
  {
   "numero": 8,
   "texte": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ"
  },
  {
   "numero": 9,
   "texte": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"
  },
  {
   "numero": 10,
   "texte": "سَيَذَّكَّرُ مَن يَخْشَىٰ"
  },
  {
   "numero": 11,
   "texte": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى"
  },
  {
   "numero": 12,
   "texte": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"
  },
  {
   "numero": 13,
   "texte": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"
  },
  {
   "numero": 14,
   "texte": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ"
  },
  {
   "numero": 15,
   "texte": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"
  },
  {
   "numero": 16,
   "texte": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"
  },
  {
   "numero": 17,
   "texte": "وَٱلْءَاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"
  },
  {
   "numero": 18,
   "texte": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"
  },
  {
   "numero": 19,
   "texte": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"
  }
 ]
}