  {
   "numero": 10,
   "texte": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"
  },
  {
   "numero": 11,
   "texte": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ"
  },
  {
   "numero": 12,
   "texte": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"
  },
  {
   "numero": 13,
   "texte": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"
  },
  {
   "numero": 14,
   "texte": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"
  },
  {
   "numero": 15,
   "texte": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"
  },
  {
   "numero": 16,
   "texte": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ"
  },
  {
   "numero": 17,
   "texte": "كَلَّا بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"
  },
  {
   "numero": 18,
   "texte": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"
  },
  {
   "numero": 19,
   "texte": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"
  },
  {
   "numero": 20,
   "texte": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"
  },
  {
   "numero": 21,
   "texte": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"
  },
  {
   "numero": 22,
   "texte": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"
  },
