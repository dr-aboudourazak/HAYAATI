{
 "numero": 111,
 "nom_arabe": "المسد",
 "versets": [
  {
   "numero": 1,
   "texte": "تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ"
  },
  {
   "numero": 2,
   "texte": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"
  },
  {
   "numero": 3,
   "texte": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"
  },
  {
   "numero": 4,
   "texte": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"
  },
  {
   "numero": 5,
   "texte": "فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ"
  }
 ]
}