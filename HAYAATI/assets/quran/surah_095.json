{
 "numero": 95,
 "nom_arabe": "التين",
 "versets": [
  {
   "numero": 1,
   "texte": "وَٱلتِّينِ وَٱلزَّيْتُونِ"
  },
  {
   "numero": 2,
   "texte": "وَطُورِ سِينِينَ"
  },
  {
   "numero": 3,
   "texte": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ"
  },
  {
   "numero": 4,
   "texte": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ"
  },
  {
   "numero": 5,
   "texte": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ"
  },
  {
   "numero": 6,
   "texte": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"
  },
  {
   "numero": 7,
   "texte": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ"
  },
  {
   "numero": 8,
   "texte": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ"
  }
 ]
}