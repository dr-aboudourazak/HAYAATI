{
 "numero": 101,
 "nom_arabe": "القارعة",
 "versets": [
  {
   "numero": 1,
   "texte": "ٱلْقَارِعَةُ"
  },
  {
   "numero": 2,
   "texte": "مَا ٱلْقَارِعَةُ"
  },
  {
   "numero": 3,
   "texte": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ"
  },
  {
   "numero": 4,
   "texte": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ"
  },
  {
   "numero": 5,
   "texte": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ"
  },
  {
   "numero": 6,
   "texte": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"
  },
  {
   "numero": 7,
   "texte": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"
  },
  {
   "numero": 8,
   "texte": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"
  },
  {
   "numero": 9,
   "texte": "فَأُمُّهُۥ هَاوِيَةٌ"
  },
  {
   "numero": 10,
   "texte": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ"
  },
  {
   "numero": 11,
   "texte": "نَارٌ حَامِيَةٌۢ"
  }
 ]
}