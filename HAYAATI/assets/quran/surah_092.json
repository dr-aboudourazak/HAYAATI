{
 "numero": 92,
 "nom_arabe": "الليل",
 "versets": [
  {
   "numero": 1,
   "texte": "وَٱلَّيْلِ إِذَا يَغْشَىٰ"
  },
  {
   "numero": 2,
   "texte": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"
  },
  {
   "numero": 3,
   "texte": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"
  },
  {
   "numero": 4,
   "texte": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ"
  },
  {
   "numero": 5,
   "texte": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"
  },
  {
   "numero": 6,
   "texte": "وَصَدَّقَ بِٱلْحُسْنَىٰ"
  },
  {
   "numero": 7,
   "texte": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"
  },
  {
   "numero": 8,
   "texte": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"
  },
  {
   "numero": 9,
   "texte": "وَكَذَّبَ بِٱلْحُسْنَىٰ"
  },
  {
   "numero": 10,
   "texte": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"
  },
  {
   "numero": 11,
   "texte": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"
  },
  {
   "numero": 12,
   "texte": "إِنَّ عَلَيْنَا لَلْهُدَىٰ"
  },
  {
   "numero": 13,
   "texte": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ"
  },
  {
   "numero": 14,
   "texte": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"
  },
  {
   "numero": 15,
   "texte": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى"
  },
  {
   "numero": 16,
   "texte": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"
  },
  {
   "numero": 17,
   "texte": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى"
  },
  {
   "numero": 18,
   "texte": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ"
  },
  {
   "numero": 19,
   "texte": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ"
  },
  {
   "numero": 20,
   "texte": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ"
  },
  {
   "numero": 21,
   "texte": "وَلَسَوْفَ يَرْضَىٰ"
  }
 ]
}