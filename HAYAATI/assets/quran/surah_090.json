   "texte": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ"
  },
  {
   "numero": 3,
   "texte": "وَوَالِدٍ وَمَا وَلَدَ"
  },
  {
   "numero": 4,
   "texte": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ"
  },
  {
   "numero": 5,
   "texte": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"
  },
  {
   "numero": 6,
   "texte": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"
  },
  {
   "numero": 7,
   "texte": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"
  },
  {
   "numero": 8,
   "texte": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"
  },
  {
   "numero": 9,
   "texte": "وَلِسَانًا وَشَفَتَيْنِ"
  },
  {
   "numero": 10,
   "texte": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ"
  },
  {
   "numero": 11,
   "texte": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"
  },
  {
   "numero": 12,
   "texte": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"
  },
  {
   "numero": 13,
   "texte": "فَكُّ رَقَبَةٍ"
  },
  {
   "numero": 14,
   "texte": "أَوْ إِطْعَٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ"
  },
  {
   "numero": 15,
   "texte": "يَتِيمًا ذَا مَقْرَبَةٍ"
  },
  {
   "numero": 16,
   "texte": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"
  },
  {
   "numero": 17,
   "texte": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"
  },
  {
   "numero": 18,
   "texte": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ"
  },
  {
