{
 "numero": 1,
 "nom_arabe": "الفاتحة",
 "versets": [
  {
   "numero": 1,
   "texte": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
  },
  {
   "numero": 2,
   "texte": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ"
  },
  {
   "numero": 3,
   "texte": "ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
  },
  {
   "numero": 4,
   "texte": "مَٰلِكِ يَوْمِ ٱلدِّينِ"
  },
  {
   "numero": 5,
   "texte": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"
  },
  {
   "numero": 6,
   "texte": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"
  },
  {
   "numero": 7,
   "texte": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ"
  }
 ]
}