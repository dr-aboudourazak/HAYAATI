 "versets": [
  {
   "numero": 1,
   "texte": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"
  },
  {
   "numero": 2,
   "texte": "مِن شَرِّ مَا خَلَقَ"
  },
  {
   "numero": 3,
   "texte": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"
  },
  {
   "numero": 4,
   "texte": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ"
  },
  {
   "numero": 5,
   "texte": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"
  }
 ]
