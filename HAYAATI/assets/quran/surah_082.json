{
 "numero": 82,
 "nom_arabe": "الإنفطار",
 "versets": [
  {
   "numero": 1,
   "texte": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ"
  },
  {
   "numero": 2,
   "texte": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ"
  },
  {
   "numero": 3,
   "texte": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ"
  },
  {
   "numero": 4,
   "texte": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ"
  },
  {
   "numero": 5,
   "texte": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ"
  },
  {
   "numero": 6,
   "texte": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ"
  },
  {
   "numero": 7,
   "texte": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"
  },
  {
   "numero": 8,
   "texte": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ"
  },
  {
   "numero": 9,
   "texte": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ"
  },
  {
   "numero": 10,
   "texte": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ"
  },
  {
   "numero": 11,
   "texte": "كِرَامًا كَٰتِبِينَ"
  },
  {
   "numero": 12,
   "texte": "يَعْلَمُونَ مَا تَفْعَلُونَ"
  },
  {
   "numero": 13,
   "texte": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"
  },
  {
   "numero": 14,
   "texte": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ"
  },
  {
   "numero": 15,
   "texte": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ"
  },
  {
   "numero": 16,
   "texte": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ"
  },
  {
   "numero": 17,
   "texte": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"
  },
  {
   "numero": 18,
   "texte": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"
  },
  {
   "numero": 19,
   "texte": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ"
  }
 ]
}