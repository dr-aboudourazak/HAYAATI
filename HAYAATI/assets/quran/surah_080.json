{
 "numero": 80,
 "nom_arabe": "عبس",
 "versets": [
  {
   "numero": 1,
   "texte": "عَبَسَ وَتَوَلَّىٰٓ"
  },
  {
   "numero": 2,
   "texte": "أَن جَآءَهُ ٱلْأَعْمَىٰ"
  },
  {
   "numero": 3,
   "texte": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"
  },
  {
   "numero": 4,
   "texte": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ"
  },
  {
   "numero": 5,
   "texte": "أَمَّا مَنِ ٱسْتَغْنَىٰ"
  },
  {
   "numero": 6,
   "texte": "فَأَنتَ لَهُۥ تَصَدَّىٰ"
  },
  {
   "numero": 7,
   "texte": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"
  },
  {
   "numero": 8,
   "texte": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"
  },
  {
   "numero": 9,
   "texte": "وَهُوَ يَخْشَىٰ"
  },
  {
   "numero": 10,
   "texte": "فَأَنتَ عَنْهُ تَلَهَّىٰ"
  },
  {
   "numero": 11,
   "texte": "كَلَّآ إِنَّهَا تَذْكِرَةٌ"
  },
  {
   "numero": 12,
   "texte": "فَمَن شَآءَ ذَكَرَهُۥ"
  },
  {
   "numero": 13,
   "texte": "فِى صُحُفٍ مُّكَرَّمَةٍ"
  },
  {
   "numero": 14,
   "texte": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ"
  },
  {
   "numero": 15,
   "texte": "بِأَيْدِى سَفَرَةٍ"
  },
  {
   "numero": 16,
   "texte": "كِرَامٍۭ بَرَرَةٍ"
  },
  {
   "numero": 17,
   "texte": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ"
  },
  {
   "numero": 18,
   "texte": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"
  },
  {
   "numero": 19,
   "texte": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"
  },
  {
   "numero": 20,
   "texte": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"
  },
  {
   "numero": 21,
   "texte": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ"
  },
  {
   "numero": 22,
   "texte": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"
  },
  {
   "numero": 23,
   "texte": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ"
  },
  {
   "numero": 24,
   "texte": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ"
  },
  {
   "numero": 25,
   "texte": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا"
  },
  {
   "numero": 26,
   "texte": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا"
  },
  {
   "numero": 27,
   "texte": "فَأَنۢبَتْنَا فِيهَا حَبًّا"
  },
  {
   "numero": 28,
   "texte": "وَعِنَبًا وَقَضْبًا"
  },
  {
   "numero": 29,
   "texte": "وَزَيْتُونًا وَنَخْلًا"
  },
  {
   "numero": 30,
   "texte": "وَحَدَآئِقَ غُلْبًا"
  },
  {
   "numero": 31,
   "texte": "وَفَٰكِهَةً وَأَبًّا"
  },
  {
   "numero": 32,
   "texte": "مَّتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ"
  },
  {
   "numero": 33,
   "texte": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"
  },
  {
   "numero": 34,
   "texte": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ"
  },
  {
   "numero": 35,
   "texte": "وَأُمِّهِۦ وَأَبِيهِ"
  },
  {
   "numero": 36,
   "texte": "وَصَٰحِبَتِهِۦ وَبَنِيهِ"
  },
  {
   "numero": 37,
   "texte": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"
  },
  {
   "numero": 38,
   "texte": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ"
  },
  {
   "numero": 39,
   "texte": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ"
  },
  {
   "numero": 40,
   "texte": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"
  },
  {
   "numero": 41,
   "texte": "تَرْهَقُهَا قَتَرَةٌ"
  },
  {
   "numero": 42,
   "texte": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ"
  }
 ]
}