 "versets": [
  {
   "numero": 1,
   "texte": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ"
  },
  {
   "numero": 2,
