{
 "numero": 97,
 "nom_arabe": "القدر",
 "versets": [
  {
   "numero": 1,
   "texte": "إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ"
  },
  {
   "numero": 2,
   "texte": "وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ"
  },
  {
   "numero": 3,
   "texte": "لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ"
  },
  {
   "numero": 4,
   "texte": "تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ"
  },
  {
   "numero": 5,
   "texte": "سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ"
  }
 ]
}