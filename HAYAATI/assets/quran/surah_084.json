{
 "numero": 84,
 "nom_arabe": "الإنشقاق",
 "versets": [
  {
   "numero": 1,
   "texte": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"
  },
  {
   "numero": 2,
   "texte": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"
  },
  {
   "numero": 3,
   "texte": "وَإِذَا ٱلْأَرْضُ مُدَّتْ"
  },
  {
   "numero": 4,
   "texte": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"
  },
  {
   "numero": 5,
   "texte": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"
  },
  {
   "numero": 6,
   "texte": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ"
  },
  {
   "numero": 7,
   "texte": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ"
  },
  {
   "numero": 8,
   "texte": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"
  },
  {
   "numero": 9,
   "texte": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا"
  },
  {
   "numero": 10,
   "texte": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"
  },
  {
   "numero": 11,
   "texte": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا"
  },
  {
   "numero": 12,
   "texte": "وَيَصْلَىٰ سَعِيرًا"
  },
  {
   "numero": 13,
   "texte": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"
  },
  {
   "numero": 14,
   "texte": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"
  },
  {
   "numero": 15,
   "texte": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا"
  },
  {
   "numero": 16,
   "texte": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ"
  },
  {
   "numero": 17,
   "texte": "وَٱلَّيْلِ وَمَا وَسَقَ"
  },
  {
   "numero": 18,
   "texte": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"
  },
  {
   "numero": 19,
   "texte": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"
  },
  {
   "numero": 20,
   "texte": "فَمَا لَهُمْ لَا يُؤْمِنُونَ"
  },
  {
   "numero": 21,
   "texte": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ"
  },
  {
   "numero": 22,
   "texte": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"
  },
  {
   "numero": 23,
   "texte": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"
  },
  {
   "numero": 24,
   "texte": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"
  },
  {
   "numero": 25,
   "texte": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"
  }
 ]
}