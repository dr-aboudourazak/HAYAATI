{
 "numero": 107,
 "nom_arabe": "الماعون",
 "versets": [
  {
   "numero": 1,
   "texte": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"
  },
  {
   "numero": 2,
   "texte": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"
  },
  {
   "numero": 3,
   "texte": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"
  },
  {
   "numero": 4,
   "texte": "فَوَيْلٌ لِّلْمُصَلِّينَ"
  },
  {
   "numero": 5,
   "texte": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"
  },
  {
   "numero": 6,
   "texte": "ٱلَّذِينَ هُمْ يُرَآءُونَ"
  },
  {
   "numero": 7,
   "texte": "وَيَمْنَعُونَ ٱلْمَاعُونَ"
  }
 ]
}