{
 "numero": 86,
 "nom_arabe": "الطارق",
 "versets": [
  {
   "numero": 1,
   "texte": "وَٱلسَّمَآءِ وَٱلطَّارِقِ"
  },
  {
   "numero": 2,
   "texte": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"
  },
  {
   "numero": 3,
   "texte": "ٱلنَّجْمُ ٱلثَّاقِبُ"
  },
  {
   "numero": 4,
   "texte": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"
  },
  {
   "numero": 5,
   "texte": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ"
  },
  {
   "numero": 6,
   "texte": "خُلِقَ مِن مَّآءٍ دَافِقٍ"
  },
  {
   "numero": 7,
   "texte": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"
  },
  {
   "numero": 8,
   "texte": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"
  },
  {
   "numero": 9,
   "texte": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"
  },
  {
   "numero": 10,
   "texte": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"
  },
  {
   "numero": 11,
   "texte": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"
  },
  {
   "numero": 12,
   "texte": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"
  },
  {
   "numero": 13,
   "texte": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ"
  },
  {
   "numero": 14,
   "texte": "وَمَا هُوَ بِٱلْهَزْلِ"
  },
  {
   "numero": 15,
   "texte": "إِنَّهُمْ يَكِيدُونَ كَيْدًا"
  },
  {
   "numero": 16,
   "texte": "وَأَكِيدُ كَيْدًا"
  },
  {
   "numero": 17,
   "texte": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"
  }
 ]
}