{
 "numero": 100,
 "nom_arabe": "العاديات",
 "versets": [
  {
   "numero": 1,
   "texte": "وَٱلْعَٰدِيَٰتِ ضَبْحًا"
  },
  {
   "numero": 2,
   "texte": "فَٱلْمُورِيَٰتِ قَدْحًا"
  },
  {
   "numero": 3,
   "texte": "فَٱلْمُغِيرَٰتِ صُبْحًا"
  },
  {
   "numero": 4,
   "texte": "فَأَثَرْنَ بِهِۦ نَقْعًا"
  },
  {
   "numero": 5,
   "texte": "فَوَسَطْنَ بِهِۦ جَمْعًا"
  },
  {
   "numero": 6,
   "texte": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌ"
  },
  {
   "numero": 7,
   "texte": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"
  },
  {
   "numero": 8,
   "texte": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"
  },
  {
   "numero": 9,
   "texte": "أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"
  },
  {
   "numero": 10,
   "texte": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ"
  },
  {
   "numero": 11,
   "texte": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"
  }
 ]
}