{
 "numero": 93,
 "nom_arabe": "الضحى",
 "versets": [
  {
   "numero": 1,
   "texte": "وَٱلضُّحَىٰ"
  },
  {
   "numero": 2,
   "texte": "وَٱلَّيْلِ إِذَا سَجَىٰ"
  },
  {
   "numero": 3,
   "texte": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"
  },
  {
   "numero": 4,
   "texte": "وَلَلْءَاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ"
  },
  {
   "numero": 5,
   "texte": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"
  },
  {
   "numero": 6,
   "texte": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ"
  },
  {
   "numero": 7,
   "texte": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ"
  },
  {
   "numero": 8,
   "texte": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ"
  },
  {
   "numero": 9,
   "texte": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ"
  },
  {
   "numero": 10,
   "texte": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ"
  },
  {
   "numero": 11,
   "texte": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"
  }
 ]
}