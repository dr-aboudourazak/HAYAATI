{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hayaati:al-ansar:annuaire:1",
  "title": "Al Ansâr : annuaire d'un pays (phase 0, sans serveur)",
  "description": "Un fichier par pays (annuaire_TG.json, annuaire_BJ.json...). Les tableaux sont normalisés (fiches, cours, articles, prestations reliés par fiche_id) pour migrer ensuite vers PostgreSQL/Supabase sans changer le modèle.",
  "type": "object",
  "required": [
    "version_schema",
    "version_donnees",
    "genere_le",
    "pays",
    "villes",
    "fiches"
  ],
  "additionalProperties": false,
  "properties": {
    "version_schema": {
      "const": 1
    },
    "version_donnees": {
      "type": "integer",
      "minimum": 1,
      "description": "À incrémenter à chaque publication. L'application ne télécharge que si ce numéro a augmenté."
    },
    "genere_le": {
      "type": "string",
      "format": "date-time"
    },
    "pays": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Code ISO 3166-1 alpha-2."
    },
    "modules_actifs": {
      "type": "array",
      "uniqueItems": true,
      "description": "Rubriques visibles dans ce pays. 'entraide_locale' n'apparaît que si elle est listée ici.",
      "items": {
        "enum": [
          "apprendre",
          "boutique",
          "accompagnement",
          "sante_spirituelle",
          "hadj_omra",
          "entraide_locale",
          "mosquees"
        ]
      }
    },
    "fiches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fiche"
      }
    },
    "cours": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/cours"
      }
    },
    "articles": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/article"
      }
    },
    "prestations": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/prestation"
      }
    },
    "villes": {
      "type": "array",
      "minItems": 1,
      "description": "Liste de référence des villes du pays. Alimente le filtre « Ville » et évite les variantes d'orthographe.",
      "items": {
        "$ref": "#/$defs/ville"
      }
    },
    "nature_fichier": {
      "enum": [
        "annuaire",
        "mosquees"
      ],
      "default": "annuaire",
      "description": "Les mosquées vivent dans un fichier à part (mosquees_TG.json) : elles sont nombreuses et chargées seulement pour la carte des mosquées proches."
    },
    "attribution": {
      "type": "string",
      "description": "Mention de licence obligatoire si des données proviennent d'OpenStreetMap (ODbL) : « © contributeurs OpenStreetMap »."
    },
    "moderation": {
      "type": "object",
      "required": [
        "whatsapp"
      ],
      "additionalProperties": false,
      "description": "Responsable qui reçoit les propositions de l'application (nouvelles mosquées, corrections).",
      "properties": {
        "whatsapp": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{6,14}$"
        }
      }
    },
    "forfaits_hadj_omra": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/forfaitHadjOmra"
      }
    },
    "demonstration": {
      "type": "boolean",
      "description": "Fichier d'exemple : ses fiches fictives s'affichent en mode démonstration. Refusé par le validateur en mode --production."
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "description": "Texte par langue (fr, en, ar, ha...). Ordre de repli dans l'app : langue active, fr, en, première langue disponible."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "Identifiant stable en minuscules, préfixé par le pays. Ne jamais réutiliser un identifiant retiré."
    },
    "devise": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 (XOF, GHS, EUR...)."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "heure": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "jour": {
      "enum": [
        "lun",
        "mar",
        "mer",
        "jeu",
        "ven",
        "sam",
        "dim"
      ]
    },
    "montant": {
      "type": "object",
      "required": [
        "montant",
        "devise"
      ],
      "additionalProperties": false,
      "properties": {
        "montant": {
          "type": "number",
          "minimum": 0
        },
        "devise": {
          "$ref": "#/$defs/devise"
        }
      }
    },
    "fiche": {
      "type": "object",
      "required": [
        "id",
        "type",
        "nature",
        "nom",
        "lieu",
        "verification",
        "statut",
        "maj_le"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "exemple": {
          "type": "boolean",
          "description": "Fiche fictive de démonstration. Refusée par le validateur en mode --production."
        },
        "type": {
          "enum": [
            "madrassa",
            "librairie",
            "boutique",
            "artisan",
            "specialiste",
            "agence",
            "mosquee"
          ]
        },
        "nature": {
          "enum": [
            "personne_physique",
            "personne_morale"
          ]
        },
        "nom": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "nom_ar": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "$ref": "#/$defs/i18n"
        },
        "langues_parlees": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "photos": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "fichier"
            ],
            "additionalProperties": false,
            "properties": {
              "fichier": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./-]+\\.(webp|jpg|jpeg)$",
                "description": "Chemin relatif, image déjà réduite (WebP, 800 px max recommandé)."
              },
              "alt": {
                "$ref": "#/$defs/i18n"
              }
            }
          }
        },
        "medias": {
          "$ref": "#/$defs/medias"
        },
        "lieu": {
          "type": "object",
          "required": [
            "ville_id"
          ],
          "additionalProperties": false,
          "properties": {
            "ville_id": {
              "$ref": "#/$defs/id",
              "description": "Référence à une entrée de « villes »."
            },
            "quartier": {
              "type": "string"
            },
            "adresse": {
              "type": "string"
            },
            "precision_adresse": {
              "enum": [
                "exacte",
                "approximative"
              ],
              "default": "approximative"
            },
            "gps": {
              "type": "object",
              "required": [
                "lat",
                "lon"
              ],
              "additionalProperties": false,
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "precision_m": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Précision du relevé GPS en mètres, si connue."
                },
                "source": {
                  "enum": [
                    "releve_sur_place",
                    "communaute",
                    "openstreetmap",
                    "estimee"
                  ],
                  "description": "Origine de la position. 'estimee' = position approximative non relevée sur place."
                },
                "verifiee": {
                  "type": "boolean",
                  "description": "Vrai quand un responsable a confirmé la position (niveau 1 minimum)."
                }
              }
            }
          }
        },
        "horaires_ouverture": {
          "$ref": "#/$defs/i18n"
        },
        "contacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "whatsapp": {
              "type": "string",
              "pattern": "^\\+[1-9]\\d{6,14}$",
              "description": "Format international E.164, sans espaces."
            },
            "telephone": {
              "type": "string",
              "pattern": "^\\+[1-9]\\d{6,14}$"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "site": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "niveau"
          ],
          "additionalProperties": false,
          "properties": {
            "niveau": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "verifie_par": {
              "type": "string",
              "description": "Code du point focal ou de l'administrateur."
            },
            "date": {
              "$ref": "#/$defs/date"
            },
            "details": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "contact_teste",
                  "existence_controlee",
                  "agrement_controle",
                  "recommandation_locale"
                ]
              }
            },
            "recommande_par": {
              "type": "string",
              "description": "Mosquée, association ou comité (niveau 3)."
            }
          },
          "if": {
            "properties": {
              "niveau": {
                "minimum": 1
              }
            },
            "required": [
              "niveau"
            ]
          },
          "then": {
            "required": [
              "verifie_par",
              "date"
            ]
          }
        },
        "formule": {
          "enum": [
            "gratuite",
            "pro"
          ]
        },
        "membre_fondateur": {
          "type": "boolean"
        },
        "statut": {
          "enum": [
            "brouillon",
            "publie",
            "suspendu",
            "retire"
          ]
        },
        "consentement_publication": {
          "type": "object",
          "required": [
            "date",
            "par"
          ],
          "additionalProperties": false,
          "properties": {
            "date": {
              "$ref": "#/$defs/date"
            },
            "par": {
              "type": "string",
              "description": "Personne ou représentant qui a autorisé la publication de la fiche."
            }
          }
        },
        "charte_acceptee_le": {
          "$ref": "#/$defs/date"
        },
        "madrassa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publics": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "enfants",
                  "adultes",
                  "femmes",
                  "hommes"
                ]
              }
            },
            "disciplines": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "coran_tajweed",
                  "aqida",
                  "fiqh",
                  "sira",
                  "hadith",
                  "arabe",
                  "autre"
                ]
              }
            },
            "ecole_juridique": {
              "enum": [
                "maliki",
                "hanafi",
                "shafii",
                "hanbali",
                "non_specifiee"
              ]
            },
            "langue_enseignement": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]{2}$"
              }
            },
            "modalite": {
              "enum": [
                "presentiel",
                "en_ligne",
                "mixte"
              ]
            },
            "places_disponibles": {
              "type": "integer",
              "minimum": 0
            },
            "enseignants": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "nom"
                ],
                "additionalProperties": false,
                "properties": {
                  "nom": {
                    "type": "string"
                  },
                  "qualification": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "specialiste": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ecoles_juridiques": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "maliki",
                  "hanafi",
                  "shafii",
                  "hanbali",
                  "non_specifiee"
                ]
              }
            },
            "delai_reponse_jours": {
              "type": "integer",
              "minimum": 0
            },
            "diplomes_agrements": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "intitule",
                  "verifie"
                ],
                "additionalProperties": false,
                "properties": {
                  "intitule": {
                    "type": "string"
                  },
                  "verifie": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "note_interne": {
          "type": "string",
          "description": "Réservé à l'équipe. Jamais affiché."
        },
        "maj_le": {
          "type": "string",
          "format": "date-time"
        },
        "zone_service": {
          "type": "object",
          "additionalProperties": false,
          "description": "Où la fiche peut rendre service, au-delà de son adresse (livraison, consultation à distance, intervention dans une autre ville). Permet de chercher pour un proche installé ailleurs.",
          "properties": {
            "pays_entier": {
              "type": "boolean"
            },
            "villes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "international": {
              "type": "boolean",
              "description": "Sert aussi des clients depuis l'étranger (à distance ou par envoi)."
            }
          }
        },
        "mosquee": {
          "type": "object",
          "additionalProperties": false,
          "description": "Informations utiles au voyageur. 'inconnu' est la valeur honnête quand personne n'a vérifié.",
          "properties": {
            "jumua": {
              "$ref": "#/$defs/triEtat"
            },
            "jumua_heure": {
              "$ref": "#/$defs/heure"
            },
            "langue_khutba": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z]{2}$"
              }
            },
            "femmes": {
              "$ref": "#/$defs/triEtat",
              "description": "Espace de prière pour les femmes."
            },
            "ablutions": {
              "$ref": "#/$defs/triEtat"
            },
            "ouverte_hors_prieres": {
              "$ref": "#/$defs/triEtat"
            },
            "acces_pmr": {
              "$ref": "#/$defs/triEtat"
            },
            "ecole_juridique": {
              "enum": [
                "maliki",
                "hanafi",
                "shafii",
                "hanbali",
                "non_specifiee"
              ]
            },
            "capacite_approx": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "source": {
          "type": "object",
          "required": [
            "origine"
          ],
          "additionalProperties": false,
          "properties": {
            "origine": {
              "enum": [
                "point_focal",
                "communaute",
                "openstreetmap"
              ]
            },
            "reference": {
              "type": "string",
              "description": "Ex. node/123456789 pour OpenStreetMap."
            },
            "importe_le": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "agence": {
          "type": "object",
          "additionalProperties": false,
          "description": "Agence de voyage Hadj et Omra. L'agrément officiel doit être contrôlé auprès de l'autorité du pays avant publication.",
          "properties": {
            "agrement": {
              "type": "object",
              "required": [
                "numero"
              ],
              "additionalProperties": false,
              "properties": {
                "numero": {
                  "type": "string",
                  "minLength": 3
                },
                "autorite": {
                  "type": "string"
                },
                "valide_jusqua": {
                  "$ref": "#/$defs/date"
                }
              }
            },
            "services": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "hadj",
                  "omra",
                  "visa",
                  "billetterie"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "mosquee"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "mosquee"
            ],
            "properties": {
              "lieu": {
                "required": [
                  "gps"
                ]
              }
            }
          },
          "else": {
            "required": [
              "contacts",
              "formule",
              "consentement_publication"
            ]
          }
        }
      ]
    },
    "medias": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Médias de la publication (lot E). HAYAATI n'héberge rien : l'image reste à son adresse https, la vidéo se lit chez YouTube.",
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https://[^\\s/@]+(/[^\\s]*)?|asset:assets/[A-Za-z0-9_./-]+\\.(png|jpg|jpeg|webp))$",
              "description": "Adresse https de l'image. « asset:assets/... » est réservé à l'application de démonstration."
            },
            "largeur": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "hauteur": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "genre": {
              "enum": [
                "affiche",
                "photo"
              ],
              "description": "Une affiche n'est jamais rognée à l'affichage."
            },
            "credit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "legende": {
              "$ref": "#/$defs/i18n"
            }
          }
        },
        "video": {
          "type": "object",
          "required": [
            "youtube"
          ],
          "additionalProperties": false,
          "properties": {
            "youtube": {
              "type": "string",
              "maxLength": 300,
              "pattern": "^([A-Za-z0-9_-]{11}|https://(www\\.|m\\.)?youtube\\.com/(watch\\?v=|shorts/|embed/|live/)[A-Za-z0-9_-]{11}([&?#/][^\\s]*)?|https://youtu\\.be/[A-Za-z0-9_-]{11}([?#/][^\\s]*)?)$",
              "description": "Identifiant YouTube (11 caractères) ou adresse https de YouTube."
            },
            "titre": {
              "$ref": "#/$defs/i18n"
            }
          }
        }
      }
    },
    "cours": {
      "type": "object",
      "required": [
        "id",
        "fiche_id",
        "sujet",
        "modalite",
        "jours",
        "horaire",
        "tarif",
        "statut"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "fiche_id": {
          "$ref": "#/$defs/id"
        },
        "sujet": {
          "$ref": "#/$defs/i18n"
        },
        "publics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "enfants",
              "adultes",
              "femmes",
              "hommes"
            ]
          }
        },
        "modalite": {
          "enum": [
            "presentiel",
            "en_ligne",
            "mixte"
          ]
        },
        "jours": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/jour"
          }
        },
        "horaire": {
          "type": "object",
          "required": [
            "debut",
            "fin"
          ],
          "additionalProperties": false,
          "description": "Heure locale de la ville de la fiche.",
          "properties": {
            "debut": {
              "$ref": "#/$defs/heure"
            },
            "fin": {
              "$ref": "#/$defs/heure"
            }
          }
        },
        "tarif": {
          "type": "object",
          "required": [
            "periodicite"
          ],
          "additionalProperties": false,
          "properties": {
            "periodicite": {
              "enum": [
                "gratuit",
                "mois",
                "session",
                "cours"
              ]
            },
            "montant": {
              "type": "number",
              "minimum": 0
            },
            "devise": {
              "$ref": "#/$defs/devise"
            }
          },
          "if": {
            "properties": {
              "periodicite": {
                "const": "gratuit"
              }
            }
          },
          "else": {
            "required": [
              "montant",
              "devise"
            ]
          }
        },
        "seuil_min": {
          "type": "integer",
          "minimum": 1
        },
        "capacite_max": {
          "type": "integer",
          "minimum": 1
        },
        "date_limite": {
          "$ref": "#/$defs/date",
          "description": "Date limite de préinscription."
        },
        "debut_prevu": {
          "$ref": "#/$defs/date"
        },
        "preinscrits": {
          "type": "object",
          "required": [
            "nombre",
            "maj_le"
          ],
          "additionalProperties": false,
          "description": "Phase 0 : compteur saisi à la main par le point focal (pas de serveur pour compter en direct). Remplacé par un comptage réel en phase 1.",
          "properties": {
            "nombre": {
              "type": "integer",
              "minimum": 0
            },
            "maj_le": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "statut": {
          "enum": [
            "ouvert_preinscriptions",
            "confirme",
            "annule",
            "termine"
          ]
        },
        "note_horaire": {
          "$ref": "#/$defs/i18n",
          "description": "Précision libre sur les horaires (ex. : horaires modifiés pendant le Ramadan)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "statut": {
                "const": "ouvert_preinscriptions"
              }
            },
            "required": [
              "statut"
            ]
          },
          "then": {
            "required": [
              "seuil_min",
              "capacite_max",
              "date_limite"
            ]
          }
        }
      ],
      "description": "Une classe de la madrassa, déjà en cours (statut 'confirme') ou en préinscription. Les jours et horaires sont toujours présents ; seuil, capacité et date limite ne concernent que les cours en préinscription."
    },
    "article": {
      "type": "object",
      "required": [
        "id",
        "fiche_id",
        "nom",
        "categorie",
        "disponibilite"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "fiche_id": {
          "$ref": "#/$defs/id"
        },
        "nom": {
          "$ref": "#/$defs/i18n"
        },
        "categorie": {
          "enum": [
            "livre",
            "tapis_priere",
            "pose_coran",
            "chapelet",
            "vetement",
            "produit_naturel",
            "autre"
          ]
        },
        "prix": {
          "$ref": "#/$defs/montant",
          "description": "Absent = prix sur demande."
        },
        "disponibilite": {
          "enum": [
            "en_stock",
            "sur_commande",
            "indisponible"
          ]
        },
        "photo": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]+\\.(webp|jpg|jpeg)$"
        },
        "avertissement_sante": {
          "type": "boolean",
          "description": "Obligatoire à true pour 'produit_naturel' : affiche la mention 'ne remplace pas un traitement'."
        },
        "livraison": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "retrait_boutique",
              "livraison",
              "retrait_mosquee"
            ]
          }
        }
      }
    },
    "prestation": {
      "type": "object",
      "required": [
        "id",
        "fiche_id",
        "besoin",
        "modalites",
        "tarif",
        "juridictions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "fiche_id": {
          "$ref": "#/$defs/id"
        },
        "besoin": {
          "enum": [
            "zakat",
            "heritage",
            "testament",
            "waqf",
            "medecine_prophetique",
            "roqya",
            "autre"
          ]
        },
        "description": {
          "$ref": "#/$defs/i18n"
        },
        "modalites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "presentiel",
              "telephone",
              "en_ligne"
            ]
          }
        },
        "juridictions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "droit_civil",
              "droit_musulman",
              "coutumier"
            ]
          }
        },
        "tarif": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "gratuit",
                "fixe",
                "fourchette",
                "sur_devis"
              ]
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "devise": {
              "$ref": "#/$defs/devise"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "fixe"
                  }
                }
              },
              "then": {
                "required": [
                  "min",
                  "devise"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "fourchette"
                  }
                }
              },
              "then": {
                "required": [
                  "min",
                  "max",
                  "devise"
                ]
              }
            }
          ]
        },
        "delai_reponse_jours": {
          "type": "integer",
          "minimum": 0
        },
        "praticiennes_pour_femmes": {
          "type": "boolean"
        }
      }
    },
    "ville": {
      "type": "object",
      "required": [
        "id",
        "nom"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nom": {
          "$ref": "#/$defs/i18n"
        },
        "region": {
          "type": "string"
        },
        "gps": {
          "type": "object",
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false,
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      }
    },
    "triEtat": {
      "enum": [
        "oui",
        "non",
        "inconnu"
      ]
    },
