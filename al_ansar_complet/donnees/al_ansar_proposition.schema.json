{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hayaati:al-ansar:proposition:1",
  "title": "Proposition envoyée depuis l'application (phase 0)",
  "type": "object",
  "required": [
    "schema",
    "type",
    "pays",
    "nom",
    "position",
    "cree_le"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "al_ansar_proposition_v1"
    },
    "type": {
      "enum": [
        "nouvelle_mosquee",
        "correction_position"
      ]
    },
    "pays": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "ville_id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "fiche_id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "position": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "precision_m": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "const": "releve_sur_place"
        }
      }
    },
    "commentaire": {
      "type": "string",
      "maxLength": 500
    },
    "cree_le": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "nouvelle_mosquee"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "ville_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "correction_position"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "fiche_id"
        ]
      }
    }
  ]
}